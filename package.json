{
  "private": true,
  "scripts": {
    "build": "spago build --pedantic-packages --strict",
    "check": "purs-tidy check --config-require \"src/**/*.purs\" && oxlint --deny-warnings src && oxfmt --check \"src/**/*.js\"",
    "format": "purs-tidy format-in-place --config-require \"src/**/*.purs\" && oxfmt --write \"src/**/*.js\""
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  }
}
